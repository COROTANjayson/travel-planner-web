# Copy to .env.local and replace the Auth0 placeholders. No client secret is needed.
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://travel-planner-api
# Server-side proxy destination; this variable is not exposed to the browser.
API_BASE_URL=http://127.0.0.1:8080
